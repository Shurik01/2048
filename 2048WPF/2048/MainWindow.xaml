<!-- #FF76D6F0 -->
<Window x:Class="_2048.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2048"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="450" MinHeight="450" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" 
        Icon="/Icon.png">
    <Grid Name="grid2048">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Canvas Background="#FF76D6F0" Grid.ColumnSpan="4" Grid.RowSpan="4">
            <Border Grid.Row="0" Grid.Column="0" Style= "{DynamicResource MyBorder}" Background="#FFD2FFFD">
                <TextBlock Style="{DynamicResource TextBlockStyle}" Text="2" Foreground="#FF7D78D1" />
            </Border>
        </Canvas>
        <Border Grid.Row="0" Grid.Column="0" Style= "{DynamicResource MyBorder}" Background="#FFD2FFFD">
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="2" Foreground="#FF7D78D1" />
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style= "{DynamicResource MyBorder}" Background="#FFCDD9FF" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="64"/>
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Style= "{DynamicResource MyBorder}" Background="#FFF6F9EC" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="4"/>
        </Border>
        <Border Grid.Row="3" Grid.Column="0" Style= "{DynamicResource MyBorder}" Background="#FFF7FFBB" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="128" />
        </Border>
        <Border Grid.Row="0" Grid.Column="1" Style= "{DynamicResource MyBorder}" Background="#FFFFC5E0" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="256"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Style= "{DynamicResource MyBorder}" Background="#FF24F9E9">
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="512"/>
        </Border>
        <Border Grid.Row="2" Grid.Column="1" Style= "{DynamicResource MyBorder}" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="1024"/>
        </Border>
        <Border Grid.Row="3" Grid.Column="1" Style= "{DynamicResource MyBorder}" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="2048"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" Style= "{DynamicResource MyBorder}" >
            <TextBlock Style="{DynamicResource TextBlockStyle}"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" Style= "{DynamicResource MyBorder}" >
            <TextBlock Style="{DynamicResource TextBlockStyle}"/>
        </Border>
        <Border Grid.Row="2" Grid.Column="2" Style= "{DynamicResource MyBorder}" >
            <TextBlock Style="{DynamicResource TextBlockStyle}"/>
        </Border>
        <Border Grid.Row="3" Grid.Column="2" Style= "{DynamicResource MyBorder}" >
            <TextBlock Style="{DynamicResource TextBlockStyle}"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="3" Style= "{DynamicResource MyBorder}" Background="#FFFFE5F0" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="8"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="3" Style= "{DynamicResource MyBorder}" Background="#FFF3E7FF" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="16"/>
        </Border>
        <Border Grid.Row="2" Grid.Column="3" Style= "{DynamicResource MyBorder}" Background="#FFDFFFE2" >
            <TextBlock Style="{DynamicResource TextBlockStyle}" Text="32"/>
        </Border>
        <Border Grid.Row="3" Grid.Column="3" Style= "{DynamicResource MyBorder}" >
            <TextBlock Style="{DynamicResource TextBlockStyle}"/>
        </Border>
        <Rectangle Width="450" Height="450" Grid.ColumnSpan="4" Grid.RowSpan="4" Fill="White" Opacity="0.6" Name="rectangle" Visibility="Hidden"></Rectangle>
        <TextBlock Text="GAME OVER..." Grid.ColumnSpan="4" Margin="92,52,83,5" Foreground="#FF4B9FC8" FontSize="36" FontWeight="Bold" FontFamily="Comic Sans MS" Visibility="Hidden" Name="gameover"/>
        <Image Source="/SadCinnamoroll.png" Grid.ColumnSpan="4" Margin="64,0,64,-15" Grid.RowSpan="3" Visibility="Hidden" Grid.Row="1" Name="sadcinnamoroll"/>
        <Border>
</Border>
        <Button Cursor="Hand" 
                Grid.ColumnSpan="3" 
                Margin="110,16,10,54" 
                Grid.Row="1" 
                Content="PLAY AGAIN" 
                FontFamily="Comic Sans MS" 
                FontSize="18" 
                FontWeight="Bold" 
                Background="#FFFDE7FF" 
                Foreground="#FF4B9FC8" 
                Name="btn_again" 
                Visibility="Hidden" 
                
                Click="btn_again_Click"/>
    </Grid>

</Window>
