<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="_2048Avalonia.Views.CloseWindow"
        Title="CloseWindow"
        Background="#DCF5FF"
        Width="400"
        Height="200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Текст -->
            <RowDefinition Height="*"/>      <!-- Изображение (растягивается) -->
            <RowDefinition Height="Auto"/>   <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Текст сверху -->
        <TextBlock Grid.Row="0"
                   Foreground="#E14FBD"
                   FontFamily="Comic Sans MS"
                   FontWeight="Bold"
                   FontSize="20"
                   Text="Вы точно хотите выйти?"
                   HorizontalAlignment="Center"/>

        <!-- Изображение по центру -->
        <Image Grid.Row="1"
               Name="CinnamorollImage"
               Source="avares://2048Avalonia/Assets/StandartCinnamoroll.png"
               Height="85"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>

        <!-- Кнопки внизу: Да слева, Нет справа -->
        <Grid Grid.Row="2" Margin="90,0,90,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button 
                    Grid.Column="0"
                    
                    Width="100" Height="30"
                    CornerRadius="10"
                    Content="Да"
                    FontFamily="Comic Sans MS"
                    FontWeight="Bold"
                    Background="White"
                    Foreground="#D83CB1"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    Click="Yes_Button_Click"
                    PointerEntered="Yes_Button_PointerEntered"
                    PointerExited="Button_PointerExited" />
                
            <Button Grid.Column="1"
                    Width="100" Height="30"
                    CornerRadius="10"
                    Content="Нет"
                    FontFamily="Comic Sans MS"
                    FontWeight="Bold"
                    Background="White"
                    Foreground="#D83CB1"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Right"
                    Click="No_Button_Click"
                    PointerEntered="No_Button_PointerEntered"
                    PointerExited="Button_PointerExited" />
        </Grid>
    </Grid>
</Window>