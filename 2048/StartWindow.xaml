<Window x:Class="_2048.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2048"
        mc:Ignorable="d"
        Title="StartWindow" Height="450" Width="695"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Canvas >
            <Canvas.Background>
                <ImageBrush ImageSource="/f05c18138a15efd3a3d11170e13e41cd.jpg"/>
            </Canvas.Background>
            <TextBlock TextWrapping="Wrap" Text="2048" FontSize="70" HorizontalAlignment="Left" Foreground="#FFF7B2B2" FontFamily="Gill Sans Ultra Bold" FontWeight="Bold" Canvas.Left="228" VerticalAlignment="Center"/>
            <Border Name="MyBorder" CornerRadius="10, 10, 10, 10" Height="68" Width="275" Canvas.Left="319" Canvas.Top="221" Background="#FFE9F4F6" BorderBrush="#FF7FCCD1" BorderThickness="4,4,4,4" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Cursor="Hand"  Content="Начать игру" Foreground="#FFF7B2B2" FontSize="28" FontFamily="Gill Sans Ultra Bold" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{x:Null}" BorderBrush="{x:Null}" FocusVisualStyle="{x:Null}" Click="Button_Click" Height="48" Width="255" MouseEnter="Button_MouseEnter" MouseLeave="Button_MouseLeave">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- Прозрачный фон, который просто пропускает клики и не реагирует на мышь визуально -->
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="MyScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
            </Border>

        </Canvas>
    </Grid>
</Window>
